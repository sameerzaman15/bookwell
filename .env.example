# Pooled Neon URL. The Vercel Neon integration sets this for you.
DATABASE_URL=postgresql://bookwell:bookwell@127.0.0.1:5432/bookwell

# Direct URL for migrations. Use the Neon unpooled URL in production.
DATABASE_URL_UNPOOLED=postgresql://bookwell:bookwell@127.0.0.1:5432/bookwell

# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

DEMO_ADMIN_EMAIL=admin@demo.bookwell.app
DEMO_ADMIN_PASSWORD=replace-with-a-random-password
DEMO_CLIENT_EMAIL=client@demo.bookwell.app
DEMO_CLIENT_PASSWORD=replace-with-a-random-password

CRON_SECRET=replace-with-a-random-secret

# Optional
BUSINESS_TIMEZONE=America/New_York
DEMO_MODE=true
